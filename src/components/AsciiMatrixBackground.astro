---
// AsciiMatrixBackground.astro
// Interactive ASCII character matrix canvas inspired by quesz.vercel.app
// Tailored to KaiNotch's PFP electric blue palette and dynamic accent colors
---

<div class="ascii-canvas-container" id="ascii-canvas-container">
  <canvas id="ascii-bg-canvas"></canvas>
  <div class="ascii-vignette"></div>
</div>

<script>
  (function initAsciiBackground() {
    const container = document.getElementById('ascii-canvas-container');
    const canvas = document.getElementById('ascii-bg-canvas') as HTMLCanvasElement | null;
    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const CHARS = ".:;+*=#%@░▒▓0189ABCDEFGHJKLMNPQRSTUVWXYZ";
    const CHARS_LEN = CHARS.length;
    const STEP_X = 14;
    const STEP_Y = 18;

    interface Particle {
      baseX: number;
      baseY: number;
      char: string;
      charIndex: number;
      speed: number;
      phase: number;
    }

    let particles: Particle[] = [];
    let mouse = { x: -1000, y: -1000 };
    let isTouch = false;
    let animId: number;
    let lastTime = 0;
    let timeOsc = 0;

    // Default to KaiNotch's vibrant electric cyan/blue: rgb(56, 189, 248)
    let primaryRgb = [56, 189, 248];

    function updateThemeColor() {
      try {
        const dummy = document.createElement('div');
        dummy.style.color = 'var(--color-primary)';
        dummy.style.display = 'none';
        document.body.appendChild(dummy);
        const comp = getComputedStyle(dummy).color;
        document.body.removeChild(dummy);
        const matches = comp.match(/\d+/g);
        if (matches && matches.length >= 3) {
          primaryRgb = [parseInt(matches[0]), parseInt(matches[1]), parseInt(matches[2])];
        }
      } catch (e) {
        primaryRgb = [56, 189, 248];
      }
    }

    updateThemeColor();
    window.addEventListener('storage', updateThemeColor);
    document.addEventListener('click', () => setTimeout(updateThemeColor, 100));

    isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0 || window.innerWidth < 768;

    // Track mouse relative to canvas (right side)
    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      if (e.clientX < rect.left) {
        // Cursor is over the left sidebar
        mouse.x = -1000;
        mouse.y = -1000;
      } else {
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      }
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    function setupCanvas() {
      if (!canvas || !ctx || !container) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const width = container.clientWidth;
      const height = container.clientHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Generate particles grid
      const cols = Math.ceil(width / STEP_X) + 1;
      const rows = Math.ceil(height / STEP_Y) + 1;
      particles = [];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * STEP_X;
          const y = r * STEP_Y;
          const charIndex = Math.floor(Math.random() * CHARS_LEN);
          particles.push({
            baseX: x,
            baseY: y,
            char: CHARS[charIndex],
            charIndex: charIndex,
            speed: 0.02 * Math.random() + 0.005,
            phase: Math.random() * Math.PI * 2
          });
        }
      }
    }

    setupCanvas();
    window.addEventListener('resize', setupCanvas);

    function render(currentTime: number) {
      if (!ctx || !canvas || !container) return;

      // Frame rate cap to ~30fps for smooth performance
      if (currentTime - lastTime < 32) {
        animId = requestAnimationFrame(render);
        return;
      }
      lastTime = currentTime;
      timeOsc += 0.04;

      const width = container.clientWidth;
      const height = container.clientHeight;

      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "#0a0a0f";
      ctx.fillRect(0, 0, width, height);

      ctx.font = "13px 'JetBrains Mono', 'Monocraft', monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const [targetR, targetG, targetB] = primaryRgb;
      const count = particles.length;

      for (let i = 0; i < count; i++) {
        const p = particles[i];

        // Random character mutation occasionally
        if (Math.random() < 0.003) {
          p.charIndex = (p.charIndex + 1) % CHARS_LEN;
          p.char = CHARS[p.charIndex];
        }

        let curX = p.baseX;
        let curY = p.baseY;
        let opacity = 0.20 + 0.08 * Math.sin(timeOsc * p.speed * 15 + p.phase);

        // Base dark muted slate-blue (subtle background state)
        let r = 38;
        let g = 48;
        let b = 68;

        if (!isTouch && mouse.x > -500) {
          const dx = p.baseX - mouse.x;
          const dy = p.baseY - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 260) {
            const proximity = 1 - dist / 260;
            // Smoothly morph toward the glowing accent color
            r = Math.floor(38 + (targetR - 38) * proximity);
            g = Math.floor(48 + (targetG - 48) * proximity);
            b = Math.floor(68 + (targetB - 68) * proximity);
            opacity = Math.min(0.92, opacity + 0.70 * proximity);

            // Repulsion physics within 85px
            if (dist < 85 && dist > 0) {
              const angle = Math.atan2(dy, dx);
              const force = 38 * Math.pow(1 - dist / 85, 1.8);
              curX = p.baseX + Math.cos(angle) * force;
              curY = p.baseY + Math.sin(angle) * force;

              // Soft clear spot right around the pointer
              if (dist < 38.25) {
                opacity *= Math.pow(dist / 38.25, 2.2);
              }
            }
          }
        }

        if (opacity > 0.01) {
          ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
          ctx.globalAlpha = opacity;
          ctx.fillText(p.char, curX, curY);
        }
      }

      ctx.globalAlpha = 1;
      animId = requestAnimationFrame(render);
    }

    animId = requestAnimationFrame(render);
  })();
</script>

<style>
  .ascii-canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: #0a0a0f;
  }

  @media screen and (min-width: 1020px) {
    .ascii-canvas-container {
      left: var(--sidebar-width);
      width: calc(100vw - var(--sidebar-width));
    }
  }

  #ascii-bg-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ascii-vignette {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.35;
    background-image: radial-gradient(circle at 50% 50%, transparent 45%, #050608 100%);
  }
</style>
