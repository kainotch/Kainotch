---
interface Props {
  title: string;
  slug: string;
  pubDate: Date;
  description?: string;
  tags?: string[];
  icon?: string;
  isNew?: boolean;
}

const { title, slug, pubDate, description, tags = [], icon = "/assets/nav-blog.png", isNew = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<a href={`/blog/${slug}`} class="post detailed">
  <div class="post-thumbnail">
    <img src={icon} alt="" width="25" height="25" />
  </div>
  <div class="post-info">
    <div class="post-title">
      <div>{title}</div>
      {isNew && <div class="button x-small">New</div>}
    </div>
    <time>{formattedDate}</time>
    {description && <p class="post-description">{description}</p>}
  </div>
  {tags.length > 0 && (
    <div class="post-tags">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>
